# Copy this file to .env (or to ~/.super_seo/.env) and fill in what you have.
# Everything is optional: a feature that needs a missing key is skipped, and the report says so.
# Real environment variables override values in this file. Never commit your .env.

# Google PageSpeed Insights: Lighthouse scores and real-user Core Web Vitals.
# Google Cloud Console -> enable "PageSpeed Insights API" -> create an API key.
PSI_API_KEY=

# Cloudflare Radar: popularity rank, categories and rank history.
# An API token with Radar read permission (not the Global API Key).
CLOUDFLARE_API_TOKEN=

# Search results for the live rank check. Brave Search API is the recommended engine.
BRAVE_API_KEY=

# Written reports, plans and AI-answer probes: set ONE of the following.
# Any OpenAI-compatible service (hosted or a local server):
LLM_API_KEY=
LLM_MODEL=
# LLM_BASE_URL=https://api.openai.com/v1
# NVIDIA NIM:
NVIDIA_API_KEY=
# Anthropic:
ANTHROPIC_API_KEY=

# Optional tuning
# SM_USER_AGENT=            # override the crawler's user-agent string (it identifies itself by default)
# CHROME_PATH=              # Chrome/Chromium location for `sm probe`
# SUPER_SEO_HOME=          # where the cache, history database and calibration live (default ~/.super_seo)
# SM_SERP_ENGINE=           # bing|duckduckgo to read result pages when no BRAVE_API_KEY is set (see README)
